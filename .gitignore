.venv/
__pycache__/
*.pyc
node_modules/
dist/
.pytest_cache/
*.egg-info/

# Windows PowerShell が LocalAppData を誤解決したときリポジトリ直下に落ちるキャッシュ
/Microsoft/

# アプリ内AIのClaude APIキー置き場(duocad/agent/providers.py の SECRETS_PATH)。
# **中身は絶対にコミットしない**。`*` は書き換え中の一時ファイル(`.tmp`)も含めるため。
/duocad_secrets.json*

# この clone だけの設定(duocad/local_settings.py。画面の「設定」が書く)。`*` は書き換え中の一時ファイル。
/duocad_settings.json*

# 実機検査のスクリーンショット(個人の画面のスクショなのでgitに載せない)。
/screenshots/

# モデルファイル（リポジトリ直下の models/ だけ）
/models/

# Claude Code のローカル設定(この端末だけの許可リスト)。`.claude/` ごとは無視しない ——
# 共有したいフック・エージェント定義を後から置けるようにする。
/.claude/settings.local.json

# 測定・実験の出力(リポジトリ直下の output/ だけ。duocad/topopt/output/ の検査成果物は追跡する)。
# docs は結論と再現コマンドを持ち、生データは持たない —— 生データは再実行で作り直す。
/output/

# STEP/STL書き出し(リポジトリ直下の export/ だけ)
/export/

# 書き出し先を変える前にルートへ落ちた成果物(移すか削除してよい)
/*.stl
/*.step
