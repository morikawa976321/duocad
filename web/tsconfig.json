{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "//": "`include` は tsc 用(.svelte は tsc が読めない)。**`.svelte` は svelte-check が見る** — 2026-08-15に追加。`npm run check` が両方を走らせるので、型検査は .ts と .svelte の両方に効く",
  "include": ["src/**/*.ts", "vite.config.ts"]
}
